# ── LLM API Keys ──────────────────────────────────────────────
# Get from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Get from https://requesty.ai/
REQUESTY_API_KEY=your_requesty_api_key_here
REQUESTY_API_URL=https://router.requesty.ai/v1/chat/completions
REQUESTY_MODEL=xiaomi/mimo-v2.6-flash

# ── Firebase ───────────────────────────────────────────────────
# Your Firebase project ID (visible in Firebase Console)
FIREBASE_PROJECT_ID=your_firebase_project_id

# For local development: path to the downloaded service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/aahaaraudit-firebase-adminsd.json

# For Render/cloud deployment: paste the ENTIRE content of the service account JSON here
# (Go to Firebase Console → Project Settings → Service accounts → Generate new private key)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
